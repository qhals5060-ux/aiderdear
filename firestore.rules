rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentEmail() {
      return request.auth.token.email;
    }

    function activePairMember(pairId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pairs/$(pairId))
        && get(/databases/$(database)/documents/pairs/$(pairId)).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.memberUids;
    }

    function validOwnMemberProfileUpdate() {
      return request.resource.data.memberProfiles is list
        && resource.data.memberProfiles is list
        && request.resource.data.memberProfiles.size() == 2
        && resource.data.memberProfiles.size() == 2
        && (
          (
            resource.data.memberProfiles[0].uid == request.auth.uid
            && request.resource.data.memberProfiles[1] == resource.data.memberProfiles[1]
            && request.resource.data.memberProfiles[0].uid == resource.data.memberProfiles[0].uid
            && request.resource.data.memberProfiles[0].email == resource.data.memberProfiles[0].email
            && request.resource.data.memberProfiles[0].photoURL == resource.data.memberProfiles[0].photoURL
            && request.resource.data.memberProfiles[0].name is string
            && request.resource.data.memberProfiles[0].name.size() > 0
            && request.resource.data.memberProfiles[0].name.size() <= 80
          )
          ||
          (
            resource.data.memberProfiles[1].uid == request.auth.uid
            && request.resource.data.memberProfiles[0] == resource.data.memberProfiles[0]
            && request.resource.data.memberProfiles[1].uid == resource.data.memberProfiles[1].uid
            && request.resource.data.memberProfiles[1].email == resource.data.memberProfiles[1].email
            && request.resource.data.memberProfiles[1].photoURL == resource.data.memberProfiles[1].photoURL
            && request.resource.data.memberProfiles[1].name is string
            && request.resource.data.memberProfiles[1].name.size() > 0
            && request.resource.data.memberProfiles[1].name.size() <= 80
          )
        );
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == currentEmail();

      allow read, delete: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /pairInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == currentEmail()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != currentEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == currentEmail());

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.fromEmail == resource.data.fromEmail
        && request.resource.data.toEmail == resource.data.toEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pairId', 'updatedAt'])
        && (
          (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled')
          ||
          (
            resource.data.toEmail == currentEmail()
            && request.resource.data.status in ['accepted', 'rejected']
            && (request.resource.data.status == 'rejected' || request.resource.data.pairId == inviteId)
          )
        );

      allow delete: if false;
    }

    match /pairs/{pairId} {
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.pairId == pairId
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.toEmail == currentEmail()
        && request.resource.data.status == 'active'
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids.hasAll([
          request.auth.uid,
          getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.fromUid
        ])
        && getAfter(/databases/$(database)/documents/pairMemberships/$(request.auth.uid)).data.pairId == pairId
        && getAfter(/databases/$(database)/documents/pairMemberships/$(getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.fromUid)).data.pairId == pairId;

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status == 'active'
        && request.resource.data.updatedAt == request.time
        && (
          (
            request.resource.data.status == 'disconnected'
            && request.resource.data.disconnectedBy == request.auth.uid
            && request.resource.data.memberUids == resource.data.memberUids
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disconnectedBy', 'updatedAt'])
          )
          ||
          (
            request.resource.data.status == resource.data.status
            && request.resource.data.memberUids == resource.data.memberUids
            && request.resource.data.memberEmails == resource.data.memberEmails
            && request.resource.data.inviteId == resource.data.inviteId
            && request.resource.data.createdAt == resource.data.createdAt
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberProfiles', 'updatedAt'])
            && validOwnMemberProfileUpdate()
          )
        );

      allow delete: if false;

      match /{document=**} {
        allow read, write: if activePairMember(pairId);
      }
    }

    match /pairMemberships/{userId} {
      allow create: if signedIn()
        && request.resource.data.uid == userId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && userId in request.resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.toEmail == currentEmail()
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.memberUids == request.resource.data.memberUids;

      allow read: if signedIn() && request.auth.uid == userId;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.status == 'disconnected'
        && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.disconnectedBy == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == userId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && userId in request.resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.toEmail == currentEmail()
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.memberUids == request.resource.data.memberUids
        && (
          resource.data.pairId == request.resource.data.pairId
          || !exists(/databases/$(database)/documents/pairs/$(resource.data.pairId))
          || get(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.status != 'active'
        );
    }

    match /friendInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == currentEmail()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != currentEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == currentEmail());

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.fromEmail == resource.data.fromEmail
        && request.resource.data.toEmail == resource.data.toEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'friendshipId', 'updatedAt'])
        && (
          (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled')
          ||
          (resource.data.toEmail == currentEmail()
            && request.resource.data.status in ['accepted', 'rejected']
            && (request.resource.data.status == 'rejected' || request.resource.data.friendshipId == inviteId))
        );

      allow delete: if false;
    }

    match /friendships/{friendshipId} {
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/friendInvites/$(friendshipId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/friendInvites/$(friendshipId)).data.friendshipId == friendshipId
        && getAfter(/databases/$(database)/documents/friendInvites/$(friendshipId)).data.toEmail == currentEmail()
        && request.resource.data.status == 'active'
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids.hasAll([
          request.auth.uid,
          getAfter(/databases/$(database)/documents/friendInvites/$(friendshipId)).data.fromUid
        ]);
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow delete: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status == 'active'
        && request.resource.data.status == resource.data.status
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.memberEmails == resource.data.memberEmails
        && request.resource.data.inviteId == resource.data.inviteId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberProfiles', 'updatedAt'])
        && validOwnMemberProfileUpdate();
    }

    match /directLetters/{letterId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == currentEmail()
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids.hasAll([request.auth.uid, request.resource.data.toUid])
        && (
          (request.resource.data.connectionType == 'pair'
            && exists(/databases/$(database)/documents/pairs/$(request.resource.data.connectionId))
            && get(/databases/$(database)/documents/pairs/$(request.resource.data.connectionId)).data.status == 'active'
            && get(/databases/$(database)/documents/pairs/$(request.resource.data.connectionId)).data.memberUids.hasAll(request.resource.data.memberUids))
          ||
          (request.resource.data.connectionType == 'friend'
            && exists(/databases/$(database)/documents/friendships/$(request.resource.data.connectionId))
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.connectionId)).data.status == 'active'
            && get(/databases/$(database)/documents/friendships/$(request.resource.data.connectionId)).data.memberUids.hasAll(request.resource.data.memberUids))
        )
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 220
        && request.resource.data.createdAt == request.time;
      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy', 'updatedAt'])
        && request.auth.uid in request.resource.data.readBy;
      allow delete: if signedIn() && request.auth.uid == resource.data.fromUid;
    }

    match /clientIntakeLinks/{token} {
      allow create: if signedIn()
        && token.size() >= 32
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'active', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.active == true
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;

      allow get: if resource.data.active == true
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
      allow list: if false;

      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.ownerName is string
        && request.resource.data.ownerName.size() <= 80
        && request.resource.data.active is bool
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'ownerName', 'active', 'updatedAt'
        ]);

      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;

      match /submissions/{submissionId} {
        allow create: if get(/databases/$(database)/documents/clientIntakeLinks/$(token)).data.active == true
          && request.resource.data.keys().hasOnly([
            'name', 'phone', 'email', 'birthYear', 'gender', 'currentSchool',
            'currentMajor', 'targetUniversity', 'targetMajor', 'applicationYear',
            'applicationSemester', 'topic', 'languageSpec', 'certifications',
            'activities', 'researchExperience', 'inquiry', 'note',
            'consent', 'source', 'status', 'createdAt'
          ])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 60
          && request.resource.data.phone is string
          && request.resource.data.phone.size() > 0
          && request.resource.data.phone.size() <= 30
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 120
          && request.resource.data.birthYear is int
          && request.resource.data.birthYear >= 0
          && request.resource.data.birthYear <= 2200
          && request.resource.data.gender in ['', 'female', 'male', 'other']
          && request.resource.data.currentSchool is string
          && request.resource.data.currentSchool.size() <= 120
          && request.resource.data.currentMajor is string
          && request.resource.data.currentMajor.size() <= 120
          && request.resource.data.targetUniversity is string
          && request.resource.data.targetUniversity.size() <= 120
          && request.resource.data.targetMajor is string
          && request.resource.data.targetMajor.size() <= 120
          && request.resource.data.applicationYear is int
          && request.resource.data.applicationYear >= 2000
          && request.resource.data.applicationYear <= 2200
          && request.resource.data.applicationSemester in ['spring', 'fall', 'rolling', 'other']
          && request.resource.data.topic is string
          && request.resource.data.topic.size() <= 1200
          && request.resource.data.languageSpec is string
          && request.resource.data.languageSpec.size() <= 1200
          && request.resource.data.certifications is string
          && request.resource.data.certifications.size() <= 1200
          && request.resource.data.activities is string
          && request.resource.data.activities.size() <= 1600
          && request.resource.data.researchExperience is string
          && request.resource.data.researchExperience.size() <= 1600
          && request.resource.data.inquiry is string
          && request.resource.data.inquiry.size() <= 2000
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 6000
          && request.resource.data.consent == true
          && request.resource.data.source == 'external-intake-v2'
          && request.resource.data.status == 'new'
          && request.resource.data.createdAt == request.time;

        allow read: if signedIn()
          && get(/databases/$(database)/documents/clientIntakeLinks/$(token)).data.ownerUid == request.auth.uid;

        allow update: if signedIn()
          && get(/databases/$(database)/documents/clientIntakeLinks/$(token)).data.ownerUid == request.auth.uid
          && resource.data.status == 'new'
          && request.resource.data.status == 'imported'
          && request.resource.data.importedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'importedAt']);

        allow delete: if signedIn()
          && get(/databases/$(database)/documents/clientIntakeLinks/$(token)).data.ownerUid == request.auth.uid;
      }
    }
  }
}
