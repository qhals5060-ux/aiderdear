rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentEmail() {
      return request.auth.token.email;
    }

    function activePairMember(pairId) {
      return signedIn()
        && exists(/databases/$(database)/documents/pairs/$(pairId))
        && get(/databases/$(database)/documents/pairs/$(pairId)).data.status == 'active'
        && request.auth.uid in get(/databases/$(database)/documents/pairs/$(pairId)).data.memberUids;
    }

    match /users/{userId} {
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == currentEmail();

      allow read, delete: if signedIn() && request.auth.uid == userId;

      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.email == resource.data.email;

      match /{document=**} {
        allow read, write: if signedIn() && request.auth.uid == userId;
      }
    }

    match /pairInvites/{inviteId} {
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.fromEmail == currentEmail()
        && request.resource.data.toEmail is string
        && request.resource.data.toEmail != currentEmail()
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time;

      allow read: if signedIn()
        && (resource.data.fromUid == request.auth.uid || resource.data.toEmail == currentEmail());

      allow update: if signedIn()
        && resource.data.status == 'pending'
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.fromEmail == resource.data.fromEmail
        && request.resource.data.toEmail == resource.data.toEmail
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'pairId', 'updatedAt'])
        && (
          (resource.data.fromUid == request.auth.uid && request.resource.data.status == 'cancelled')
          ||
          (
            resource.data.toEmail == currentEmail()
            && request.resource.data.status in ['accepted', 'rejected']
            && (request.resource.data.status == 'rejected' || request.resource.data.pairId == inviteId)
          )
        );

      allow delete: if false;
    }

    match /pairs/{pairId} {
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.pairId == pairId
        && getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.toEmail == currentEmail()
        && request.resource.data.status == 'active'
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.resource.data.memberUids.hasAll([
          request.auth.uid,
          getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.fromUid
        ])
        && getAfter(/databases/$(database)/documents/pairMemberships/$(request.auth.uid)).data.pairId == pairId
        && getAfter(/databases/$(database)/documents/pairMemberships/$(getAfter(/databases/$(database)/documents/pairInvites/$(pairId)).data.fromUid)).data.pairId == pairId;

      allow read: if signedIn() && request.auth.uid in resource.data.memberUids;

      allow update: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && resource.data.status == 'active'
        && request.resource.data.status == 'disconnected'
        && request.resource.data.disconnectedBy == request.auth.uid
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberUids == resource.data.memberUids
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'disconnectedBy', 'updatedAt']);

      allow delete: if false;

      match /{document=**} {
        allow read, write: if activePairMember(pairId);
      }
    }

    match /pairMemberships/{userId} {
      allow create: if signedIn()
        && request.resource.data.uid == userId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && userId in request.resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.toEmail == currentEmail()
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.memberUids == request.resource.data.memberUids;

      allow read: if signedIn() && request.auth.uid == userId;

      allow delete: if signedIn()
        && request.auth.uid in resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.status == 'disconnected'
        && getAfter(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.disconnectedBy == request.auth.uid;

      allow update: if signedIn()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.uid == userId
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.memberUids is list
        && request.resource.data.memberUids.size() == 2
        && request.auth.uid in request.resource.data.memberUids
        && userId in request.resource.data.memberUids
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.status == 'accepted'
        && getAfter(/databases/$(database)/documents/pairInvites/$(request.resource.data.pairId)).data.toEmail == currentEmail()
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.status == 'active'
        && getAfter(/databases/$(database)/documents/pairs/$(request.resource.data.pairId)).data.memberUids == request.resource.data.memberUids
        && (
          resource.data.pairId == request.resource.data.pairId
          || !exists(/databases/$(database)/documents/pairs/$(resource.data.pairId))
          || get(/databases/$(database)/documents/pairs/$(resource.data.pairId)).data.status != 'active'
        );
    }
  }
}
