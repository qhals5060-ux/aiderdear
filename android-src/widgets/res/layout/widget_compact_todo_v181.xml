<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w181_row" android:layout_width="match_parent" android:layout_height="26dp" android:forceDarkAllowed="false">
