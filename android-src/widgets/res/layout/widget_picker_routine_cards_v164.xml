<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:forceDarkAllowed="false">
  <ImageView android:id="@+id/widget_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/widget_theme_system_surface_v190" android:scaleType="fitXY" android:contentDescription="@null"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:padding="8dp" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:orientation="horizontal" android:gravity="center_vertical">
      <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#352C40" android:includeFontPadding="false" android:textStyle="bold" android:layout_weight="1" android:text="ROUTINE"/>
      <TextView android:id="@+id/widget_subtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#716B80" android:includeFontPadding="false" android:text="1 / 3 완료"/>
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
      <ListView android:id="@+id/widget_items_v164" android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none" android:divider="@null" android:contentDescription="루틴" android:visibility="gone"/>
      <LinearLayout android:id="@+id/widget_preview_rows_v164" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:visibility="visible">
        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w194_routine_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingTop="3dp" android:paddingBottom="5dp">
          <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:id="@+id/w194_routine_title" android:layout_width="0dp" android:layout_height="wrap_content" android:textSize="12sp" android:textColor="#352C40" android:includeFontPadding="false" android:maxLines="1" android:ellipsize="end" android:textStyle="bold" android:layout_weight="1" android:text="아침 스트레칭"/>
            <TextView android:id="@+id/w194_routine_meta" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#716B80" android:includeFontPadding="false" android:maxLines="1" android:layout_marginLeft="6dp" android:text="12일 · MINI"/>
          </LinearLayout>
          <ProgressBar android:id="@+id/w194_routine_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="3dp" android:layout_marginTop="5dp" android:max="100" android:progressDrawable="@drawable/widget_theme_system_progress_v190" android:progress="40"/>
          <LinearLayout android:id="@+id/w194_routine_actions" android:layout_width="match_parent" android:layout_height="30dp" android:layout_marginTop="4dp" android:orientation="horizontal">
            <TextView android:id="@+id/w194_level_0" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="9sp" android:textColor="#7561DC" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:layout_marginRight="3dp" android:background="@drawable/widget_theme_system_selected_v190" android:text="MINI"/>
            <TextView android:id="@+id/w194_level_1" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="9sp" android:textColor="#716B80" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:layout_marginRight="3dp" android:background="@drawable/widget_theme_system_outline_v190" android:text="MORE"/>
            <TextView android:id="@+id/w194_level_2" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="9sp" android:textColor="#716B80" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:layout_marginRight="3dp" android:background="@drawable/widget_theme_system_outline_v190" android:text="MAX"/>
            <TextView android:id="@+id/w194_level_3" android:layout_width="0dp" android:layout_height="match_parent" android:textSize="9sp" android:textColor="#716B80" android:includeFontPadding="false" android:layout_weight="1" android:gravity="center" android:layout_marginRight="3dp" android:background="@drawable/widget_theme_system_outline_v190" android:text="SKIP"/>
          </LinearLayout>
        </LinearLayout>
      </LinearLayout>
      <TextView android:id="@+id/widget_empty" android:layout_width="match_parent" android:layout_height="match_parent" android:textSize="10sp" android:textColor="#352C40" android:includeFontPadding="false" android:visibility="gone" android:gravity="center"/>
    </FrameLayout>
  </LinearLayout>
</FrameLayout>