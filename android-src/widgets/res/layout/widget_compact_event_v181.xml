<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/w181_row" android:layout_width="match_parent" android:layout_height="26dp" android:forceDarkAllowed="false">
  <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:paddingLeft="4dp" android:paddingRight="4dp">
    <TextView android:id="@+id/w181_dot" android:layout_width="10dp" android:layout_height="wrap_content" android:text="●" android:textSize="7sp" android:textColor="#7561DC" android:includeFontPadding="false"/>
    <TextView android:id="@+id/w181_time" android:layout_width="34dp" android:layout_height="wrap_content" android:textSize="10.5sp" android:textColor="#171A3A" android:singleLine="true" android:includeFontPadding="false" android:fontFamily="sans-serif"/>
    <TextView android:id="@+id/w181_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textSize="11.5sp" android:textColor="#171A3A" android:singleLine="true" android:ellipsize="end" android:includeFontPadding="false" android:fontFamily="sans-serif"/>
  </LinearLayout>
  <ImageView android:layout_width="match_parent" android:layout_height="0.5dp" android:layout_gravity="bottom" android:background="#E4DFEE" android:contentDescription="@null"/>
</FrameLayout>
