<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="#FFF7F6FF"
    android:paddingLeft="18dp" android:paddingTop="24dp" android:paddingRight="18dp" android:paddingBottom="18dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="위젯 설정" android:textColor="#FF171A3A" android:textSize="26sp" android:textStyle="bold"
        android:paddingLeft="4dp" android:paddingBottom="4dp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="홈 화면에서 표시할 내용과 모양을 조정합니다."
        android:textColor="#FF62647B" android:textSize="13sp" android:paddingLeft="4dp" android:paddingBottom="16dp" />
    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:fillViewport="true" android:overScrollMode="never">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <FrameLayout android:id="@+id/widget_config_preview_v164" android:layout_width="match_parent" android:layout_height="280dp" android:background="@drawable/widget_config_row_v157" android:padding="12dp" />
            <TextView android:id="@id/widget_config_theme" android:layout_width="match_parent" android:layout_height="66dp"
                android:layout_marginTop="12dp" android:background="@drawable/widget_config_row_v157"
                android:gravity="center_vertical" android:text="색상과 테마                                      ›"
                android:textColor="#FF171A3A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@id/widget_config_opacity" android:layout_width="match_parent" android:layout_height="66dp"
                android:layout_marginTop="8dp" android:background="@drawable/widget_config_row_v157"
                android:gravity="center_vertical" android:text="배경 불투명도                                   ›"
                android:textColor="#FF171A3A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@id/widget_config_font" android:layout_width="match_parent" android:layout_height="66dp"
                android:layout_marginTop="8dp" android:background="@drawable/widget_config_row_v157"
                android:gravity="center_vertical" android:text="글자 크기                                          ›"
                android:textColor="#FF171A3A" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@id/widget_config_content" android:layout_width="match_parent" android:layout_height="66dp"
                android:layout_marginTop="8dp" android:layout_marginBottom="12dp" android:background="@drawable/widget_config_row_v157"
                android:gravity="center_vertical" android:text="표시할 내용                                       ›"
                android:textColor="#FF171A3A" android:textSize="16sp" android:textStyle="bold" />
        </LinearLayout>
    </ScrollView>
    <LinearLayout android:layout_width="match_parent" android:layout_height="58dp" android:layout_marginTop="12dp"
        android:orientation="horizontal" android:gravity="center">
        <Button android:id="@id/widget_config_cancel" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:background="@drawable/widget_config_row_v157" android:text="취소" android:textColor="#FF171A3A"
            android:textSize="16sp" android:textStyle="bold" />
        <Button android:id="@id/widget_config_save" android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginLeft="10dp" android:background="@drawable/widget_config_button_v157"
            android:text="저장" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
