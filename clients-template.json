{
  "type": "AdaptiveCard",
  "version": "1.5",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "body": [
    {"type":"TextBlock","text":"${eyebrow}","size":"Small","weight":"Bolder","color":"Accent","spacing":"None"},
    {"type":"TextBlock","text":"${title}","size":"ExtraLarge","weight":"Bolder","wrap":true,"spacing":"Small"},
    {"type":"Container","$data":"${items}","separator":true,"spacing":"Small","items":[
      {"type":"ColumnSet","columns":[
        {"type":"Column","width":"stretch","items":[{"type":"TextBlock","text":"${name}","weight":"Bolder","wrap":true},{"type":"TextBlock","text":"${stage}","size":"Small","isSubtle":true,"spacing":"None"}]},
        {"type":"Column","width":"auto","verticalContentAlignment":"Center","items":[{"type":"TextBlock","text":"${next}","size":"Small","weight":"Bolder","color":"Accent"}]}
      ]}
    ]},
    {"type":"TextBlock","text":"${empty}","isVisible":"${$count(items) == 0}","isSubtle":true,"wrap":true}
  ],
  "actions":[{"type":"Action.OpenUrl","title":"Clients 열기","url":"https://aiderdear1.vercel.app/?widget=clients"}]
}
