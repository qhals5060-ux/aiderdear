# Public production origin, without a trailing slash
PUBLIC_APP_URL=https://aiderdear1.vercel.app

# Firebase Admin (choose JSON or the three split values)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Random secrets (32+ characters)
CALENDAR_STATE_SECRET=
CRON_SECRET=

# Google Cloud OAuth 2.0 Web application
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Public Notion integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Verification token shown when the Notion webhook subscription is created
NOTION_WEBHOOK_SECRET=
