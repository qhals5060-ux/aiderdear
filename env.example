# Public production origin, without a trailing slash
PUBLIC_APP_URL=https://aiderdear1.vercel.app

# Firebase Admin (choose JSON or the three split values)
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Random secrets (32+ characters). Vercel Cron sends CRON_SECRET as a Bearer token.
CALENDAR_STATE_SECRET=
CRON_SECRET=

# Google Cloud OAuth 2.0 Web application.
# This server OAuth connection requests Calendar event read/write plus calendar-list
# read access. It stores an offline refresh token for webhook and scheduled sync.
# OAuth consent screen (Testing): add qhals5060@gmail.com and aidway55@gmail.com as Test users.
# Authorized JavaScript origin: https://aiderdear1.vercel.app
# Authorized redirect URI: https://aiderdear1.vercel.app/api/calendar-sync?action=callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Couple sharing never uses a partner Google token or calendar. Shared event rows
# are mirrored only to pairs/{pairId}/schedules/{ownerUid} in Firestore.

# Public Notion integration
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
# Verification token shown when the Notion webhook subscription is created
NOTION_WEBHOOK_SECRET=
